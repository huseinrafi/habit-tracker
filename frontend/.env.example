# API Gateway / Lambda endpoint
VITE_API_URL=https://your-api-gateway-id.execute-api.us-east-1.amazonaws.com/prod

# AWS region for service calls
VITE_AWS_REGION=us-east-1

# Cognito User Pool (optional, for Cognito-based auth)
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=

# S3 bucket for file uploads (used with pre-signed URLs)
VITE_S3_BUCKET=your-uploads-bucket

# Upload Lambda endpoint for generating pre-signed URLs
VITE_UPLOAD_URL=https://your-api-gateway-id.execute-api.us-east-1.amazonaws.com/prod/upload
